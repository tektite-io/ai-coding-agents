{
  "$schema": "https://opencode.ai/config.json",

  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openrouter", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "orcarouter", "effect": "allow" },
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "allow" },
    { "action": "provider.use", "resource": "llama.cpp", "effect": "allow" }
  ],

  "providers": {
    "orcarouter": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "OrcaRouter",
      "settings": {
        "baseURL": "https://api.orcarouter.ai/v1"
      },
      "models": {
        "auto": {
          "name": "OrcaRouter Auto"
        }
      }
    },

    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash:floor": {
          "name": "DeepSeek V4.1 Flash Cheapest"
        }
      }
    },

    "llama.cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      }
    },

    "amazon-bedrock": {
      "settings": {
        "region": "us-west-2",
        "profile": "genai-dev"
      }
    },
    "openai": {
      "models": {
        "gpt-daybreak-blue-latest": {
          "name": "GPT Daybreak Blue",
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },

  "default_agent": "plan",
  "update": "auto",

  "instructions": [
    "~/.ai-agents/rules/*.md"
  ],

  "share": "disabled",

  "plugins": [
    "@sveltejs/opencode",
    "opencode-websearch-addons",
    "opencode-usage-quota-tracker",
    "github:jadmadi/opencode-distill"
  ],

  "permissions": [
    { "action": "read", "resource": ".env", "effect": "allow" },
    { "action": "read", "resource": ".env.*", "effect": "allow" },
    { "action": "read", "resource": ".env-*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": ":(){:|:&};:", "effect": "deny" }
  ],

  "mcp": {
    "servers": {
      "awslabs.aws-documentation-mcp-server": {
        "type": "local",
        "command": [
          "uvx",
          "awslabs.aws-documentation-mcp-server@latest"
        ],
        "environment": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        }
      },

      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },

      "gitnexus": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "gitnexus",
          "mcp"
        ]
      },

      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ]
      },
      "cognee": {
        // Shared durable memory (global_memory / project_<slug> /
        // security_corpus) - see AGENTS.md's "Memory & Wiki" section.
        // brought up with ENABLE_BACKEND_ACCESS_CONTROL=true, so this token is required.
        "type": "remote",
        "url": "http://localhost:8001/mcp",
        "headers": {
          "Authorization": "Bearer {file:~/.secrets/opencode/cognee-token}"
        }
      },

      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": true
        // "headers": {
        //   "Authorization": "Bearer {file:~/.secrets/opencode/github-token}"
        // }
      }
    }
  }
}
